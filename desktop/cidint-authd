#!/usr/bin/env python3
"""cidint-authd - privileged half of the CIDINT login screen and desktop.

Listens on /run/cidint-auth/socket. Every request is one JSON line; the
caller is identified by the kernel (SO_PEERCRED), never by what it says.

  login    {user, password}   only from the login screen (user
                              cidint-greeter); user must be in the group
                              cidint-desktop. Starts that user's session.
  passwd   {old, new}         the caller's own password
  power    {action}           reboot or poweroff; from the login screen
                              or the user whose session is running
  logout   {}                 ends the caller's running session
  ai_chat  {question}         answer from the local AI engine (sandboxed,
                              no network); from the session user
  status   {}                 which user's session is running
  store_*  {id}               software store: list, refresh, install,
                              remove (signed apps); desktop users

Failed logins are slowed down (2 s, growing to 10 s). Passwords are never
logged. Exit codes: 0 stopped, 1 failure.
"""
import ctypes
import grp
import hmac
import json
import os
import pwd
import socket
import struct
import subprocess
import sys
import threading
import time

SOCK_DIR = "/run/cidint-auth"
SOCK = SOCK_DIR + "/socket"
GREETER = "cidint-greeter"
GROUP = "cidint-desktop"
MIN_LEN = 8

_crypt = ctypes.CDLL("libcrypt.so.1")
_crypt.crypt.restype = ctypes.c_char_p
_crypt.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]

shadow_lock = threading.Lock()
ai_lock = threading.Lock()
fail_lock = threading.Lock()
store_lock = threading.Lock()
failures = 0


def log(msg: str):
    print(msg, flush=True)


def stored_hash(user: str) -> str:
    with open("/etc/shadow", encoding="utf-8") as f:
        for line in f:
            parts = line.rstrip("\n").split(":")
            if parts and parts[0] == user and len(parts) > 1:
                return parts[1]
    return ""


def password_ok(user: str, password: str) -> bool:
    h = stored_hash(user)
    if not h.startswith("$"):
        return False  # locked or no password: never accepted
    out = _crypt.crypt(password.encode(), h.encode())
    return out is not None and hmac.compare_digest(out, h.encode())


def desktop_users() -> list:
    try:
        return list(grp.getgrnam(GROUP).gr_mem)
    except KeyError:
        return []


def root_is_ro() -> bool:
    opts = ""
    with open("/proc/mounts", encoding="utf-8") as f:
        for line in f:
            p = line.split()
            if len(p) > 3 and p[1] == "/":
                opts = p[3]
    return "ro" in opts.split(",")


def set_hash(user: str, new_hash: str):
    """Replace user's hash in /etc/shadow (atomic rename)."""
    with shadow_lock:
        ro = root_is_ro()
        if ro:
            subprocess.run(["mount", "-o", "remount,rw", "/"], check=True)
        try:
            with open("/etc/shadow", encoding="utf-8") as f:
                lines = f.read().split("\n")
            out, found = [], False
            for line in lines:
                p = line.split(":")
                if p and p[0] == user and len(p) > 1:
                    p[1] = new_hash
                    found = True
                out.append(":".join(p))
            if not found:
                raise RuntimeError("user not in /etc/shadow")
            tmp = "/etc/.shadow.cidint-new"
            mode = os.stat("/etc/shadow").st_mode & 0o7777
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write("\n".join(out))
                f.flush()
                os.fsync(f.fileno())
            os.chmod(tmp, mode)
            os.replace(tmp, "/etc/shadow")
            dfd = os.open("/etc", os.O_RDONLY)
            os.fsync(dfd)
            os.close(dfd)
        finally:
            if ro:
                subprocess.run(["mount", "-o", "remount,ro", "/"])


def make_hash(password: str) -> str:
    r = subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=password, capture_output=True,
                       text=True, check=True)
    h = r.stdout.strip()
    if not h.startswith("$6$"):
        raise RuntimeError("unexpected hash format")
    return h


def session_user() -> str:
    r = subprocess.run(["systemctl", "list-units", "--type=service", "--state=active,activating",
                        "--plain", "--no-legend", "cidint-desktop@*.service"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        unit = line.split()[0] if line.split() else ""
        if unit.startswith("cidint-desktop@") and unit.endswith(".service"):
            return unit[len("cidint-desktop@"):-len(".service")]
    return ""


def valid_new(pw: str) -> str:
    if len(pw) < MIN_LEN:
        return f"the password must have at least {MIN_LEN} characters"
    if ":" in pw or "\n" in pw:
        return "the password must not contain ':' or line breaks"
    return ""


def handle(req: dict, uid: int) -> dict:
    global failures
    op = req.get("op")
    try:
        caller = pwd.getpwuid(uid).pw_name
    except KeyError:
        return {"ok": False, "error": "unknown caller"}

    if op == "status":
        return {"ok": True, "session_user": session_user(), "desktop_users": desktop_users()}

    if op == "login":
        if caller != GREETER and uid != 0:
            return {"ok": False, "error": "only the login screen may start a session"}
        user, pw = str(req.get("user", "")), str(req.get("password", ""))
        if session_user():
            return {"ok": False, "error": "a session is already running"}
        good = user in desktop_users() and password_ok(user, pw)
        if not good:
            with fail_lock:
                failures += 1
                delay = min(10, 2 * failures)
            log(f"login failed for user {user!r} (attempt {failures})")
            time.sleep(delay)
            return {"ok": False, "error": "wrong user name or password"}
        with fail_lock:
            failures = 0
        log(f"login: starting the session of {user}")
        # The session unit conflicts with the login screen, which stops.
        subprocess.Popen(["systemctl", "--no-block", "start", f"cidint-desktop@{user}.service"])
        return {"ok": True}

    if op == "passwd":
        if caller not in desktop_users():
            return {"ok": False, "error": "only desktop users can change their password here"}
        old, new = str(req.get("old", "")), str(req.get("new", ""))
        if not password_ok(caller, old):
            time.sleep(2)
            return {"ok": False, "error": "the current password is wrong"}
        err = valid_new(new)
        if err:
            return {"ok": False, "error": err}
        set_hash(caller, make_hash(new))
        log(f"password changed for {caller}")
        return {"ok": True}

    if op == "power":
        action = req.get("action")
        if action not in ("reboot", "poweroff"):
            return {"ok": False, "error": "unknown action"}
        if caller != GREETER and caller != session_user() and uid != 0:
            return {"ok": False, "error": "not allowed"}
        log(f"{action} requested by {caller}")
        subprocess.Popen(["systemctl", "--no-block", action])
        return {"ok": True}

    if op == "logout":
        if not caller or caller != session_user():
            return {"ok": False, "error": "no session of yours is running"}
        log(f"logout of {caller}")
        subprocess.Popen(["systemctl", "--no-block", "stop", f"cidint-desktop@{caller}.service"])
        return {"ok": True}

    if op == "ai_chat":
        if caller != session_user():
            return {"ok": False, "error": "only the user of the running session may ask"}
        q = str(req.get("question", "")).strip()
        if not q or len(q) > 2000 or "\x00" in q:
            return {"ok": False, "error": "the question is empty or too long"}
        if not ai_lock.acquire(blocking=False):
            return {"ok": False, "error": "the assistant is busy with another question"}
        try:
            r = subprocess.run(["cidint-ai", "chat", "-n", "256", q], capture_output=True, text=True, timeout=600)
        except subprocess.TimeoutExpired:
            return {"ok": False, "error": "no answer within 10 minutes"}
        finally:
            ai_lock.release()
        if r.returncode != 0:
            return {"ok": False, "error": (r.stderr.strip() or "the engine failed")[-300:]}
        return {"ok": True, "answer": r.stdout.strip()}

    if op in ("store_list", "store_refresh", "store_install", "store_remove"):
        if caller not in desktop_users():
            return {"ok": False, "error": "only desktop users can use the software store"}
        sys.path.insert(0, "/usr/lib/cidint/desktop")
        from cidint_desktop import store
        try:
            with store_lock:
                if op == "store_refresh":
                    store.refresh()
                elif op == "store_install":
                    meta = store.install(str(req.get("id", "")))
                    log(f"store: {caller} installed {meta.get('id')} {meta.get('version')}")
                elif op == "store_remove":
                    store.remove(str(req.get("id", "")))
                    log(f"store: {caller} removed {req.get('id')}")
                return {"ok": True, "source": store.source(), "apps": store.catalogue()}
        except store.StoreError as e:
            return {"ok": False, "error": str(e)}

    return {"ok": False, "error": "unknown request"}


def serve_one(conn: socket.socket):
    with conn:
        try:
            conn.settimeout(60)
            cred = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
            _pid, uid, _gid = struct.unpack("3i", cred)
            data = b""
            while not data.endswith(b"\n") and len(data) < 16384:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
            req = json.loads(data.decode() or "{}")
            if not isinstance(req, dict):
                raise ValueError("not an object")
            conn.settimeout(None)
            reply = handle(req, uid)
        except Exception as e:  # never crash the service on one request
            reply = {"ok": False, "error": f"bad request ({type(e).__name__})"}
        try:
            conn.sendall((json.dumps(reply) + "\n").encode())
        except OSError:
            pass


def main() -> int:
    if os.geteuid() != 0:
        print("cidint-authd: must run as root", file=sys.stderr)
        return 1
    os.makedirs(SOCK_DIR, mode=0o755, exist_ok=True)
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o666)  # who may do what is decided per request
    srv.listen(16)
    log("cidint-authd: ready")
    while True:
        conn, _ = srv.accept()
        threading.Thread(target=serve_one, args=(conn,), daemon=True).start()


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""cidint-wifi - Wi-Fi from the command line (the same code as Settings).

  cidint-wifi devices
  cidint-wifi scan [DEVICE]
  cidint-wifi connect NAME [DEVICE]     passphrase on standard input
                                        (an empty line for open networks)
  cidint-wifi disconnect [DEVICE]
  cidint-wifi forget NAME [DEVICE]

Needs root or membership in the group netdev. Exit codes: 0 ok, 1 failed,
2 usage, 3 no Wi-Fi device."""
import sys
import time

sys.path.insert(0, "/usr/lib/cidint/desktop")
from cidint_desktop import wifi  # noqa: E402


def device(name: str) -> dict:
    devs = [d for d in wifi.devices() if d["station"] and (not name or d["name"] == name)]
    if not devs:
        print("cidint-wifi: no Wi-Fi device in station mode" + (f" named {name}" if name else ""), file=sys.stderr)
        sys.exit(3)
    return devs[0]


def find(dev: dict, name: str) -> dict:
    for attempt in range(3):
        for n in wifi.networks(dev["path"]):
            if n["name"] == name:
                return n
        wifi.scan(dev["path"])
        time.sleep(4)
    print(f"cidint-wifi: network '{name}' not found", file=sys.stderr)
    sys.exit(1)


def main(argv) -> int:
    if not argv:
        print(__doc__.split("\n\n", 1)[1], file=sys.stderr)
        return 2
    op, args = argv[0], argv[1:]
    try:
        if op == "devices":
            for d in wifi.devices():
                print(f"{d['name']}  mode={d['mode']}  powered={d['powered']}  state={d['state'] or '-'}  "
                      f"connected={d['connected'] or '-'}")
        elif op == "scan":
            dev = device(args[0] if args else "")
            wifi.scan(dev["path"])
            time.sleep(5)
            for n in wifi.networks(dev["path"]):
                flags = ("connected " if n["connected"] else "") + ("saved" if n["known"] else "")
                print(f"{n['signal']:6.1f} dBm  {n['security']:5}  {n['name']}  {flags}")
        elif op == "connect" and args:
            dev = device(args[1] if len(args) > 1 else "")
            net = find(dev, args[0])
            pw = sys.stdin.readline().rstrip("\n") if not sys.stdin.isatty() else ""
            wifi.connect(net["path"], pw)
            print(f"connected to {args[0]}")
        elif op == "disconnect":
            wifi.disconnect(device(args[0] if args else "")["path"])
            print("disconnected")
        elif op == "forget" and args:
            dev = device(args[1] if len(args) > 1 else "")
            wifi.forget(find(dev, args[0])["path"])
            print(f"forgot {args[0]}")
        else:
            print(__doc__.split("\n\n", 1)[1], file=sys.stderr)
            return 2
    except wifi.WifiError as e:
        print(f"cidint-wifi: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

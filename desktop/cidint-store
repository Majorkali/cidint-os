#!/usr/bin/env python3
"""cidint-store - install and remove signed applications (as root).

  cidint-store source [ADDRESS]   show or set the software source
                                  (https://..., http://..., file://... or a directory)
  cidint-store refresh            download and verify the catalogue
  cidint-store list               catalogue with installed versions
  cidint-store install ID
  cidint-store remove ID

The desktop's Software app does the same through cidint-authd.
Exit codes: 0 ok, 1 failed, 2 usage, 6 not root."""
import os
import sys

sys.path.insert(0, "/usr/lib/cidint/desktop")
from cidint_desktop import store  # noqa: E402


def main(argv) -> int:
    if not argv or argv[0] not in ("source", "refresh", "list", "install", "remove"):
        print(__doc__.split("\n\n", 1)[1], file=sys.stderr)
        return 2
    op, args = argv[0], argv[1:]
    if op != "list" and not (op == "source" and not args) and os.geteuid() != 0:
        print("cidint-store: must be run as root", file=sys.stderr)
        return 6
    try:
        if op == "source":
            if args:
                store.set_source(args[0])
            print(store.source() or "(none)")
        elif op == "refresh":
            idx = store.refresh()
            print(f"catalogue verified: {len(idx['apps'])} app(s)")
        elif op == "list":
            for a in store.catalogue():
                state = f"installed {a['installed']}" if a["installed"] else "not installed"
                print(f"{a['id']:24} {a.get('version', ''):10} {state:22} {a.get('name', '')}: {a.get('summary', '')}")
        elif op == "install" and len(args) == 1:
            meta = store.install(args[0])
            print(f"installed {meta['name']} {meta['version']}")
        elif op == "remove" and len(args) == 1:
            store.remove(args[0])
            print(f"removed {args[0]}")
        else:
            print(__doc__.split("\n\n", 1)[1], file=sys.stderr)
            return 2
    except store.StoreError as e:
        print(f"cidint-store: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/bin/sh
# CIDINT OS image customisation. Runs inside the image at build time.
set -e
export DEBIAN_FRONTEND=noninteractive
APT="apt-get -y -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef"

echo "CIDINT: installing optional packages"
: > /usr/share/cidint/optional-missing.txt
while read -r pkg; do
    case "$pkg" in ''|\#*) continue ;; esac
    if ! $APT install "$pkg" </dev/null >/tmp/cidint-apt.log 2>&1; then
        echo "$pkg" >> /usr/share/cidint/optional-missing.txt
        echo "CIDINT: optional package unavailable: $pkg"
    fi
done < /usr/share/cidint/optional-packages.list

# 32-bit Windows programs need wine32, which needs the i386 architecture.
if [ "$(dpkg --print-architecture)" = "amd64" ] && command -v wine >/dev/null 2>&1; then
    dpkg --add-architecture i386
    if apt-get update >/dev/null 2>&1 && $APT install wine32:i386 >/tmp/cidint-apt.log 2>&1; then
        echo "CIDINT: wine32 installed"
    else
        echo "wine32:i386" >> /usr/share/cidint/optional-missing.txt
    fi
fi

echo "CIDINT: configuring Tor (transparent proxy, started only in Anonymous Mode)"
cat >> /etc/tor/torrc <<'EOF'

## CIDINT OS Anonymous Mode
VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1
TransPort 127.0.0.1:9040
DNSPort 127.0.0.1:5353
EOF

echo "CIDINT: services"
chmod 0755 /usr/bin/cidint
systemctl enable nftables.service apparmor.service cidint-hwadapt.service cidint-sentinel.service \
                 cidint-user.service
# Anonymity is an explicit user choice; nothing phones home at boot.
systemctl disable tor.service 2>/dev/null || true
for unit in clamav-freshclam.service avahi-daemon.service avahi-daemon.socket cups-browsed.service \
            apt-daily.timer apt-daily-upgrade.timer fwupd-refresh.timer snapd.service snapd.socket \
            ssh.service libvirtd.service; do
    systemctl disable "$unit" 2>/dev/null || true
done

echo "CIDINT: malware signatures"
if command -v freshclam >/dev/null 2>&1; then
    freshclam --quiet 2>/dev/null || echo "CIDINT: could not download ClamAV signatures (run 'sudo freshclam' later)"
fi

echo "CIDINT: branding"
# ID and VERSION_CODENAME stay as Debian's: apt, distrobox and other tools rely on
# them. Everything a person sees says CIDINT OS.
sed -i -e 's/^PRETTY_NAME=.*/PRETTY_NAME="CIDINT OS 0.1"/' \
       -e 's/^NAME=.*/NAME="CIDINT OS"/' \
       -e 's/^VERSION=.*/VERSION="0.1"/' \
       -e '/^\(HOME_URL\|SUPPORT_URL\|BUG_REPORT_URL\|LOGO\)=/d' /usr/lib/os-release
# /etc/os-release is what programs actually read; make sure it is the same file.
rm -f /etc/os-release
ln -s ../usr/lib/os-release /etc/os-release

# Login screen: CIDINT wallpaper instead of the Debian artwork.
for theme in /usr/share/sddm/themes/*/; do
    [ -f "$theme/theme.conf" ] || continue
    printf '[General]\nbackground=/usr/share/cidint/wallpaper.svg\ntype=image\n' > "$theme/theme.conf.user"
done

# Boot splash: a plain text theme that shows the OS name, no distribution logo.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme tribar 2>/dev/null || plymouth-set-default-theme text 2>/dev/null || true
fi
printf 'CIDINT OS 0.1 \\n \\l\n\n' > /etc/issue
printf 'CIDINT OS 0.1\n' > /etc/issue.net
cat > /etc/motd <<'EOF'

  CIDINT OS  |  Secure. Anonymous. Intelligent. Adaptive.
  Type "cidint status" for the security posture, "cidint --help" for everything else.

EOF

echo "CIDINT: compiling python"
python3 -m compileall -q /usr/lib/cidint || true

# Machine identifiers must be generated per boot, never shipped in the image.
rm -f /etc/machine-id /var/lib/dbus/machine-id
: > /etc/machine-id

rm -f /tmp/cidint-apt.log
apt-get clean
echo "CIDINT: setup hook finished"

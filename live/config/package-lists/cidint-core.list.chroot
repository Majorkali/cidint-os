kde-plasma-desktop
sddm
plasma-nm
plasma-pa
konsole
dolphin
kate
ark
kdialog
firefox-esr
pipewire-audio
xdg-utils
fonts-noto-core

# --- base system ---
sudo
polkitd
pkexec
network-manager
ca-certificates
curl
python3
python3-pyqt6
zram-tools
power-profiles-daemon

# --- security and privacy ---
apparmor
apparmor-utils
apparmor-profiles
nftables
tor
torsocks
bubblewrap
cryptsetup
gnupg
clamav
wireguard-tools
openssh-client

# --- application compatibility ---

#!/bin/sh
# cidint-root-password - set the root password of an installed CIDINT OS.
#
#   cidint-root-password                 change the root password (as root)
#   cidint-root-password --first-start   used by the console login services
#
# CIDINT OS images ship with root locked: there is no default password.
# On the first start of a disk image the console asks for a root password
# before it offers a login. Live media (cidint.mode=amnesic) are not
# asked: they keep nothing and log in on the local console automatically.
#
# The password is stored as a SHA-512 crypt hash in /etc/shadow on the
# running system slot; A/B updates carry it over to the new slot.
#
# Exit codes: 0 ok, 1 failure, 2 usage, 6 not root, 7 refused.
set -eu

PROG=cidint-root-password
LOCK=/run/cidint-root-password.lock
MIN=8

fail()   { echo "$PROG: error: $*" >&2; exit 1; }

has_password() { awk -F: '$1 == "root" { found = 1; exit ($2 ~ /^\$[0-9a-z]+\$/) ? 0 : 1 } END { if (!found) exit 1 }' /etc/shadow; }

amnesic() { tr ' ' '\n' < /proc/cmdline | grep -qx 'cidint.mode=amnesic'; }

# read_secret LABEL -> $SECRET. Returns 1 if a password was set on another
# console while waiting.
read_secret() {
    printf '%s: ' "$1"
    stty -echo 2>/dev/null || true
    SECRET=""
    while :; do
        if IFS= read -r -t 5 SECRET; then
            break
        fi
        if [ "$FIRST" -eq 1 ] && has_password; then
            stty echo 2>/dev/null || true
            echo
            return 1
        fi
        sleep 1
    done
    stty echo 2>/dev/null || true
    echo
}

store() {   # store HASH: replace root's hash in /etc/shadow
    HASH=$1
    WAS_RO=0
    if awk '$2 == "/" { print $4 }' /proc/mounts | tail -n 1 | tr ',' '\n' | grep -qx ro; then
        WAS_RO=1
        mount -o remount,rw / || fail "could not make the system slot writable"
    fi
    MODE=$(stat -c %a /etc/shadow)
    awk -F: -v OFS=: -v h="$HASH" '$1 == "root" { $2 = h } { print }' /etc/shadow > /etc/.shadow.cidint-new
    chmod "$MODE" /etc/.shadow.cidint-new
    sync
    mv /etc/.shadow.cidint-new /etc/shadow
    sync
    [ "$WAS_RO" -eq 0 ] || mount -o remount,ro / || echo "$PROG: warning: the system slot stays writable until the next start" >&2
    has_password || fail "the password was not stored"
}

FIRST=0
case "${1:-}" in
    --first-start) FIRST=1 ;;
    "") ;;
    *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

[ "$(id -u)" -eq 0 ] || { echo "$PROG: must be run as root" >&2; exit 6; }

if [ "$FIRST" -eq 1 ]; then
    amnesic && exit 0
    has_password && exit 0
    echo
    echo "CIDINT OS first start: root has no password yet."
    echo "Choose one now. It is needed for every login on this machine."
fi

while :; do
    if [ "$FIRST" -eq 1 ] && has_password; then
        echo "The root password was set on another console."
        exit 0
    fi
    read_secret "Choose a root password (at least $MIN characters)" || exit 0
    P1=$SECRET
    if [ "${#P1}" -lt "$MIN" ]; then
        echo "Too short."
        [ "$FIRST" -eq 1 ] && continue || exit 7
    fi
    case "$P1" in *:*)
        echo "The password must not contain ':'."
        [ "$FIRST" -eq 1 ] && continue || exit 7 ;;
    esac
    read_secret "Repeat the root password" || exit 0
    if [ "$SECRET" != "$P1" ]; then
        echo "The two entries differ."
        [ "$FIRST" -eq 1 ] && continue || exit 7
    fi
    break
done

# Only one console may write at a time.
while ! mkdir "$LOCK" 2>/dev/null; do sleep 1; done
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
if [ "$FIRST" -eq 1 ] && has_password; then
    echo "The root password was set on another console."
    exit 0
fi
HASH=$(printf '%s' "$P1" | openssl passwd -6 -stdin) || fail "could not hash the password"
case "$HASH" in '$6$'*) ;; *) fail "unexpected password hash format" ;; esac
store "$HASH"
echo "The root password is set."

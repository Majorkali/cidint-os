#!/bin/sh
# cidint-root-password - set passwords on an installed CIDINT OS.
#
#   cidint-root-password                 change the root password (as root)
#   cidint-root-password --user NAME     set the password of user NAME (as root)
#   cidint-root-password --first-start   used by the console login services
#
# CIDINT OS images ship with every account locked: there is no default
# password. On the first start of a disk image the console asks for a root
# password, and for the desktop user's password on the Desktop Edition,
# before it offers a login. Live media (cidint.mode=amnesic) are not
# asked: they keep nothing and log in automatically on the local console.
#
# Passwords are stored as SHA-512 crypt hashes in /etc/shadow on the
# running system slot; A/B updates carry them over to the new slot.
#
# Exit codes: 0 ok, 1 failure, 2 usage, 6 not root, 7 refused.
set -eu

PROG=cidint-root-password
LOCK=/run/cidint-root-password.lock
MIN=8

fail() { echo "$PROG: error: $*" >&2; exit 1; }

has_password() { awk -F: -v u="$1" '$1 == u { found = 1; exit ($2 ~ /^\$[0-9a-z]+\$/) ? 0 : 1 } END { if (!found) exit 1 }' /etc/shadow; }

amnesic() { tr ' ' '\n' < /proc/cmdline | grep -qx 'cidint.mode=amnesic'; }

# Accounts that need a password at first start: root, then the members of
# the group cidint-desktop (Desktop Edition).
accounts() {
    echo root
    awk -F: '$1 == "cidint-desktop" { n = split($4, m, ","); for (i = 1; i <= n; i++) if (m[i] != "") print m[i] }' /etc/group
}

missing() {
    for a in $(accounts); do
        has_password "$a" || echo "$a"
    done
}

# read_secret LABEL -> $SECRET. Returns 1 if, at first start, everything
# was set on another console while waiting.
read_secret() {
    printf '%s: ' "$1"
    stty -echo 2>/dev/null || true
    SECRET=""
    while :; do
        if IFS= read -r -t 5 SECRET; then
            break
        fi
        if [ "$FIRST" -eq 1 ] && [ -z "$(missing)" ]; then
            stty echo 2>/dev/null || true
            echo
            return 1
        fi
        sleep 1
    done
    stty echo 2>/dev/null || true
    echo
}

store() {   # store USER HASH: replace USER's hash in /etc/shadow
    WAS_RO=0
    if awk '$2 == "/" { print $4 }' /proc/mounts | tail -n 1 | tr ',' '\n' | grep -qx ro; then
        WAS_RO=1
        mount -o remount,rw / || fail "could not make the system slot writable"
    fi
    MODE=$(stat -c %a /etc/shadow)
    awk -F: -v OFS=: -v u="$1" -v h="$2" '$1 == u { $2 = h } { print }' /etc/shadow > /etc/.shadow.cidint-new
    chmod "$MODE" /etc/.shadow.cidint-new
    sync
    mv /etc/.shadow.cidint-new /etc/shadow
    sync
    [ "$WAS_RO" -eq 0 ] || mount -o remount,ro / || echo "$PROG: warning: the system slot stays writable until the next start" >&2
    has_password "$1" || fail "the password was not stored"
}

# ask_and_store USER: ask twice, then store. Returns 1 if not needed any more.
ask_and_store() {
    U=$1
    while :; do
        if [ "$FIRST" -eq 1 ] && has_password "$U"; then
            return 0
        fi
        read_secret "Choose a password for $U (at least $MIN characters)" || return 1
        P1=$SECRET
        if [ "${#P1}" -lt "$MIN" ]; then
            echo "Too short."
            [ "$FIRST" -eq 1 ] && continue || exit 7
        fi
        case "$P1" in *:*)
            echo "The password must not contain ':'."
            [ "$FIRST" -eq 1 ] && continue || exit 7 ;;
        esac
        read_secret "Repeat the password" || return 1
        if [ "$SECRET" != "$P1" ]; then
            echo "The two entries differ."
            [ "$FIRST" -eq 1 ] && continue || exit 7
        fi
        break
    done
    # Only one console may write at a time.
    while ! mkdir "$LOCK" 2>/dev/null; do sleep 1; done
    trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
    if [ "$FIRST" -eq 1 ] && has_password "$U"; then
        rmdir "$LOCK"; trap - EXIT
        echo "The password of $U was set on another console."
        return 0
    fi
    HASH=$(printf '%s' "$P1" | openssl passwd -6 -stdin) || fail "could not hash the password"
    case "$HASH" in '$6$'*) ;; *) fail "unexpected password hash format" ;; esac
    store "$U" "$HASH"
    rmdir "$LOCK"; trap - EXIT
    echo "The password of $U is set."
}

FIRST=0
TARGET=root
case "${1:-}" in
    --first-start) FIRST=1 ;;
    --user) [ $# -eq 2 ] || exit 2; TARGET=$2 ;;
    "") ;;
    *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

[ "$(id -u)" -eq 0 ] || { echo "$PROG: must be run as root" >&2; exit 6; }

if [ "$FIRST" -eq 0 ]; then
    grep -q "^$TARGET:" /etc/shadow || fail "no such account: $TARGET"
    ask_and_store "$TARGET"
    exit 0
fi

amnesic && exit 0
[ -n "$(missing)" ] || exit 0
echo
echo "CIDINT OS first start: these accounts have no password yet: $(missing | tr '\n' ' ')"
echo "Choose them now. They are needed to log in on this machine."
for a in $(missing); do
    ask_and_store "$a" || { echo "The passwords were set on another console."; exit 0; }
done

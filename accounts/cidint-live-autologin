#!/bin/sh
# systemd generator: on a live medium (cidint.mode=amnesic) log root in
# automatically on the local consoles, and on the Desktop Edition start the
# desktop session of the user cidint without the login screen. Live sessions
# keep nothing and have no passwords; no network login service exists and
# inbound connections are dropped by the firewall. Installed systems are
# untouched.
set -eu
out=${1:-/run/systemd/generator}

tr ' ' '\n' < /proc/cmdline | grep -qx 'cidint.mode=amnesic' || exit 0

mkdir -p "$out/serial-getty@.service.d" "$out/getty@.service.d"
cat > "$out/serial-getty@.service.d/cidint-live-autologin.conf" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty -8 -L --autologin root --keep-baud 115200,38400,9600 %I $TERM
EOF
cat > "$out/getty@.service.d/cidint-live-autologin.conf" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --noclear --autologin root %I $TERM
EOF

for dir in /usr/lib/systemd/system /lib/systemd/system; do
    if [ -f "$dir/cidint-desktop@.service" ]; then
        mkdir -p "$out/multi-user.target.wants"
        ln -sf "$dir/cidint-desktop@.service" "$out/multi-user.target.wants/cidint-desktop@cidint.service"
        break
    fi
done

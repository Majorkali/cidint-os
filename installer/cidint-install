#!/bin/sh
# cidint-install - install CIDINT OS from the live medium onto a disk.
#
# Creates the CIDINT layout on the target disk (GPT, UEFI):
#   1 esp          128 MiB   boot loader and kernel
#   2 system-a    1024 MiB   read-only system image
#   3 system-b    1024 MiB   reserved for A/B updates (left empty)
#   4 cidint-data  the rest  /data: everything that must survive
#
# THIS ERASES THE TARGET DISK. Safety rules, all enforced below:
#   - the target must be named explicitly; nothing is ever auto-selected
#   - a disk that already has a partition table or filesystem is refused
#     unless --erase-existing is given
#   - the erase must be confirmed by typing the device path (or by
#     repeating it with --confirm-erase for unattended installs)
#   - mounted disks, read-only devices and the live medium are refused
#   - --dry-run performs every check and changes nothing
#
# Optional: --encrypt-data puts the data volume in a LUKS2 container that
# is unlocked with a passphrase at every start. The system slots hold no
# user data and are not encrypted. A lost passphrase cannot be recovered.
#
# Exit codes: 0 installed (or dry run ok), 1 failure, 2 usage,
#             6 not root, 7 refused to protect data.
set -eu

PROG=cidint-install
WORK=/run/cidint-install
MIN_BYTES=4294967296   # 4 GiB

TARGET=""
CONFIRM=""
SOURCE=""
DRY=0
ENCRYPT=0
PASS_FILE=""
ROOTPW_FILE=""
KARGS=""
MAPPER=cidint-data
ERASE_EXISTING=0
LIST=0

say()    { echo "$PROG: $*"; }
fail()   { echo "$PROG: error: $*" >&2; exit 1; }
refuse() { echo "$PROG: refused: $*" >&2; exit 7; }

usage() {
    cat <<EOF
Usage: $PROG --list
       $PROG --target /dev/DISK [--dry-run] [--erase-existing]
                    [--confirm-erase /dev/DISK] [--source DIR]
                    [--encrypt-data [--passphrase-file FILE]]
                    [--root-password-file FILE] [--kernel-args "ARGS"]

  --list             show the disks that could be chosen; changes nothing
  --target DEV       whole disk to install to. ALL DATA ON IT IS ERASED.
  --dry-run          run every check, print the plan, change nothing
  --erase-existing   allow a disk that already holds partitions or data
  --confirm-erase D  confirm the erase without a prompt; must equal --target
  --source DIR       directory holding rootfs.img, bzImage and EFI/BOOT
                     (default: found on the live medium)
  --encrypt-data     encrypt the data volume (LUKS2). The passphrase is
                     asked for at every start; if it is lost, the data is lost.
  --passphrase-file F   read the passphrase from the first line of F
                     instead of asking (unattended installs)
  --root-password-file F   set the root password of the installed system
                     from the first line of F (asked for when interactive)
  --kernel-args ARGS extra kernel arguments for the installed system
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --list) LIST=1 ;;
        --target) [ $# -ge 2 ] || { usage >&2; exit 2; }; TARGET="$2"; shift ;;
        --confirm-erase) [ $# -ge 2 ] || { usage >&2; exit 2; }; CONFIRM="$2"; shift ;;
        --source) [ $# -ge 2 ] || { usage >&2; exit 2; }; SOURCE="$2"; shift ;;
        --passphrase-file) [ $# -ge 2 ] || { usage >&2; exit 2; }; PASS_FILE="$2"; shift ;;
        --root-password-file) [ $# -ge 2 ] || { usage >&2; exit 2; }; ROOTPW_FILE="$2"; shift ;;
        --kernel-args) [ $# -ge 2 ] || { usage >&2; exit 2; }; KARGS="$2"; shift ;;
        --encrypt-data) ENCRYPT=1 ;;
        --dry-run) DRY=1 ;;
        --erase-existing) ERASE_EXISTING=1 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "$PROG: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

disk_bytes() { echo $(( $(cat "/sys/block/$1/size") * 512 )); }
disk_model() { cat "/sys/block/$1/device/model" 2>/dev/null | sed 's/ *$//' || true; }

list_disks() {
    printf '%-14s %-12s %-4s %s\n' DEVICE SIZE-MiB RO MODEL
    for d in /sys/block/*; do
        n=$(basename "$d")
        case "$n" in loop*|ram*|zram*|dm-*|md*) continue ;; esac
        printf '%-14s %-12s %-4s %s\n' "/dev/$n" "$(( $(disk_bytes "$n") / 1048576 ))" \
            "$(cat "$d/ro")" "$(disk_model "$n")"
    done
}

if [ "$LIST" -eq 1 ]; then
    list_disks
    exit 0
fi

[ -n "$TARGET" ] || { usage >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || { echo "$PROG: must be run as root" >&2; exit 6; }

# ---- checks: nothing below this line writes until "point of no return" ----

[ -b "$TARGET" ] || refuse "$TARGET is not a block device"
NAME=$(basename "$TARGET")
[ -d "/sys/block/$NAME" ] || refuse "$TARGET is a partition or not a whole disk; name the disk itself"
[ "$(cat "/sys/block/$NAME/ro")" = "0" ] || refuse "$TARGET is read-only"
[ "$(cat "/sys/block/$NAME/size")" != "0" ] || refuse "$TARGET has no medium"

BYTES=$(disk_bytes "$NAME")
[ "$BYTES" -ge "$MIN_BYTES" ] || refuse "$TARGET is $(( BYTES / 1048576 )) MiB; at least 4096 MiB is required"

if grep -q "^/dev/$NAME[p0-9]* " /proc/mounts; then
    refuse "$TARGET or one of its partitions is mounted"
fi
if grep -q "^/dev/$NAME" /proc/swaps 2>/dev/null; then
    refuse "$TARGET is in use as swap"
fi

# Locate the installation source.
find_source() {
    if [ -n "$SOURCE" ]; then echo "$SOURCE"; return 0; fi
    while read -r _dev mnt _rest; do
        if [ -f "$mnt/rootfs.img" ]; then echo "$mnt"; return 0; fi
    done < /proc/mounts
    mkdir -p "$WORK/src"
    for dev in /dev/sr0 /dev/sr1 $(blkid -t TYPE=iso9660 -o device 2>/dev/null || true); do
        [ -b "$dev" ] || continue
        if mount -o ro "$dev" "$WORK/src" 2>/dev/null; then
            if [ -f "$WORK/src/rootfs.img" ]; then echo "$WORK/src"; return 0; fi
            umount "$WORK/src" 2>/dev/null || true
        fi
    done
    return 1
}

SRC=$(find_source) || fail "installation source (rootfs.img) not found; use --source DIR"
for f in rootfs.img bzImage EFI/BOOT/bootx64.efi; do
    [ -f "$SRC/$f" ] || fail "installation source $SRC lacks $f"
done

SRC_DEV=$(awk -v m="$SRC" '$2 == m { d = $1 } END { print d }' /proc/mounts)
case "$SRC_DEV" in
    "/dev/$NAME"|"/dev/$NAME"[p0-9]*) refuse "$TARGET is the medium this system is running from" ;;
esac

IMG_BYTES=$(stat -c %s "$SRC/rootfs.img")
[ "$IMG_BYTES" -le 1073741824 ] || fail "system image is $IMG_BYTES bytes; it does not fit the 1024 MiB system slot"

# Does the disk already hold something?
HAS_CONTENT=0
for p in "/sys/block/$NAME/$NAME"*; do
    [ -e "$p" ] && HAS_CONTENT=1
done
if [ -n "$(blkid -p -o value -s PTTYPE "$TARGET" 2>/dev/null || true)" ] || \
   [ -n "$(blkid -p -o value -s TYPE "$TARGET" 2>/dev/null || true)" ]; then
    HAS_CONTENT=1
fi
if [ "$HAS_CONTENT" -eq 1 ] && [ "$ERASE_EXISTING" -ne 1 ]; then
    refuse "$TARGET already contains a partition table or filesystem. Back up anything you need, then repeat with --erase-existing"
fi

DATA_MIB=$(( BYTES / 1048576 - 128 - 1024 - 1024 - 2 ))

# Secrets are checked before anything is erased.
first_line() { IFS= read -r _l < "$1" || true; printf '%s' "$_l"; }
ask_secret() {   # ask_secret "what" -> value in $SECRET (asked twice)
    stty -echo
    printf '%s: ' "$1"; IFS= read -r SECRET || SECRET=""; echo
    printf 'Repeat %s: ' "$1"; IFS= read -r _again || _again=""; echo
    stty echo
    [ "$SECRET" = "$_again" ] || refuse "the two entries differ; nothing was changed"
}

[ -z "$PASS_FILE" ] || [ "$ENCRYPT" -eq 1 ] || { echo "$PROG: --passphrase-file needs --encrypt-data" >&2; exit 2; }
if [ "$ENCRYPT" -eq 1 ]; then
    command -v cryptsetup >/dev/null 2>&1 || fail "cryptsetup is not available on this system"
    [ -e /dev/mapper/$MAPPER-install ] && refuse "/dev/mapper/$MAPPER-install already exists"
    [ -z "$PASS_FILE" ] || [ -r "$PASS_FILE" ] || fail "cannot read $PASS_FILE"
fi
[ -z "$ROOTPW_FILE" ] || [ -r "$ROOTPW_FILE" ] || fail "cannot read $ROOTPW_FILE"
command -v openssl >/dev/null 2>&1 || fail "openssl is not available to hash the root password"

echo
echo "Installation plan"
echo "  source      : $SRC (system image $(( IMG_BYTES / 1048576 )) MiB)"
echo "  target      : $TARGET  $(( BYTES / 1048576 )) MiB  $(disk_model "$NAME")"
echo "  existing    : $([ "$HAS_CONTENT" -eq 1 ] && echo 'partitions or data present - WILL BE ERASED' || echo 'none detected')"
echo "  1 esp          128 MiB  FAT32"
echo "  2 system-a    1024 MiB  system image, mounted read-only"
echo "  3 system-b    1024 MiB  empty, reserved for updates"
if [ "$ENCRYPT" -eq 1 ]; then
    echo "  4 cidint-data ${DATA_MIB} MiB  LUKS2 (passphrase at every start), ext4 inside, /data"
else
    echo "  4 cidint-data ${DATA_MIB} MiB  ext4, /data, NOT ENCRYPTED (use --encrypt-data)"
fi
echo

if [ "$DRY" -eq 1 ]; then
    say "dry run: all checks passed, nothing was changed"
    exit 0
fi

INTERACTIVE=0
if [ "$CONFIRM" != "$TARGET" ]; then
    INTERACTIVE=1
    [ -z "$CONFIRM" ] || refuse "--confirm-erase '$CONFIRM' does not match the target '$TARGET'"
    [ -t 0 ] || refuse "no confirmation given; repeat with --confirm-erase $TARGET"
    printf 'Everything on %s will be erased. Type the device path to continue: ' "$TARGET"
    read -r answer || answer=""
    [ "$answer" = "$TARGET" ] || refuse "confirmation did not match; nothing was changed"
fi

# With --confirm-erase the run is unattended: nothing below asks a question.
PASSPHRASE=""
if [ "$ENCRYPT" -eq 1 ]; then
    if [ -n "$PASS_FILE" ]; then
        PASSPHRASE=$(first_line "$PASS_FILE")
    else
        [ "$INTERACTIVE" -eq 1 ] || refuse "no passphrase given; use --passphrase-file FILE"
        echo "Choose the passphrase for the data volume. If it is lost, the data cannot be recovered."
        ask_secret "Data volume passphrase"; PASSPHRASE=$SECRET
    fi
    [ "${#PASSPHRASE}" -ge 8 ] || refuse "the passphrase must have at least 8 characters; nothing was changed"
fi
ROOTPW=""
if [ -n "$ROOTPW_FILE" ]; then
    ROOTPW=$(first_line "$ROOTPW_FILE")
    [ -n "$ROOTPW" ] || refuse "$ROOTPW_FILE is empty; nothing was changed"
elif [ "$INTERACTIVE" -eq 1 ]; then
    echo "Set the root password of the installed system (empty: keep the development default, no password)."
    ask_secret "Root password"; ROOTPW=$SECRET
fi
case "$ROOTPW" in *:*) refuse "the root password must not contain ':'; nothing was changed" ;; esac

# ---- point of no return ---------------------------------------------------

mkdir -p "$WORK"
KEY="$WORK/key"
cleanup() {
    rm -f "$KEY"
    cryptsetup close "$MAPPER-install" 2>/dev/null || true
    umount "$WORK/root" 2>/dev/null || true
    umount "$WORK/esp" 2>/dev/null || true
    umount "$WORK/src" 2>/dev/null || true
}
trap cleanup EXIT

case "$NAME" in
    *[0-9]) P="${TARGET}p" ;;
    *)      P="$TARGET" ;;
esac

say "partitioning $TARGET"
sfdisk --wipe always --wipe-partitions always "$TARGET" <<EOF
label: gpt
size=128MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="esp"
size=1024MiB, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="system-a"
size=1024MiB, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="system-b"
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="cidint-data"
EOF
udevadm settle 2>/dev/null || sleep 3
for n in 1 2 3 4; do
    [ -b "${P}${n}" ] || fail "partition ${P}${n} did not appear"
done

say "creating filesystems"
mkfs.vfat -F 32 -n ESP "${P}1" >/dev/null
if [ "$ENCRYPT" -eq 1 ]; then
    say "encrypting the data volume (LUKS2)"
    ( umask 077; printf '%s' "$PASSPHRASE" > "$KEY" )
    cryptsetup luksFormat --type luks2 --batch-mode --label cidint-data-luks         --key-file "$KEY" "${P}4" || fail "could not create the encrypted volume"
    cryptsetup open --type luks2 --key-file "$KEY" "${P}4" "$MAPPER-install"         || fail "could not open the new encrypted volume"
    rm -f "$KEY"
    DATA_DEV="/dev/mapper/$MAPPER-install"
else
    DATA_DEV="${P}4"
fi
mkfs.ext4 -q -F -L cidint-data "$DATA_DEV"
e2fsck -fn "$DATA_DEV" >/dev/null 2>&1 || fail "data volume failed its filesystem check"
if [ "$ENCRYPT" -eq 1 ]; then
    sync
    cryptsetup close "$MAPPER-install" || fail "could not close the encrypted volume"
    [ "$(blkid -o value -s TYPE "${P}4")" = "crypto_LUKS" ] || fail "data partition is not a LUKS volume after formatting"
fi

say "writing the system image to ${P}2"
# Plain dd plus sync: busybox dd does not always support conv=fsync.
# Errors are shown, not hidden.
dd if="$SRC/rootfs.img" of="${P}2" bs=1M || fail "writing the system image failed"
sync
e2fsck -fy "${P}2" >/dev/null 2>&1 || [ $? -le 1 ] || fail "system image failed its filesystem check after writing"
resize2fs "${P}2" >/dev/null 2>&1 || fail "could not grow the system filesystem"

udevadm settle 2>/dev/null || true
UUID_ESP=$(blkid -o value -s PARTUUID "${P}1")
UUID_A=$(blkid -o value -s PARTUUID "${P}2")
UUID_DATA=$(blkid -o value -s PARTUUID "${P}4")
[ -n "$UUID_ESP" ] && [ -n "$UUID_A" ] && [ -n "$UUID_DATA" ] || fail "could not read partition identifiers"

say "configuring mounts"
mkdir -p "$WORK/root" "$WORK/esp"
mount "${P}2" "$WORK/root"
mkdir -p "$WORK/root/boot" "$WORK/root/data"
if [ "$ENCRYPT" -eq 1 ]; then
    echo "$MAPPER	PARTUUID=$UUID_DATA	none	luks" > "$WORK/root/etc/crypttab"
    chmod 600 "$WORK/root/etc/crypttab"
    DATA_SPEC="/dev/mapper/$MAPPER"
else
    DATA_SPEC="PARTUUID=$UUID_DATA"
fi
cat >> "$WORK/root/etc/fstab" <<EOF
PARTUUID=$UUID_ESP	/boot	vfat	defaults	0	0
$DATA_SPEC	/data	ext4	defaults	0	2
EOF
if [ -n "$ROOTPW" ]; then
    say "setting the root password"
    HASH=$(printf '%s' "$ROOTPW" | openssl passwd -6 -stdin) || fail "could not hash the root password"
    case "$HASH" in '$6$'*) ;; *) fail "unexpected password hash format" ;; esac
    awk -F: -v OFS=: -v h="$HASH" '$1 == "root" { $2 = h } { print }' "$WORK/root/etc/shadow" > "$WORK/shadow.new" \
        || fail "could not prepare the password file"
    cat "$WORK/shadow.new" > "$WORK/root/etc/shadow"
    rm -f "$WORK/shadow.new"
    grep -q '^root:\$6\$' "$WORK/root/etc/shadow" || fail "the root password was not stored as a hash"
fi
sync
umount "$WORK/root"

say "installing the boot loader"
mount "${P}1" "$WORK/esp"
mkdir -p "$WORK/esp/EFI/BOOT"
cp "$SRC/EFI/BOOT/bootx64.efi" "$WORK/esp/EFI/BOOT/bootx64.efi"
cp "$SRC/bzImage" "$WORK/esp/bzImage"
CONSOLES=$(tr ' ' '\n' < /proc/cmdline | grep '^console=' | tr '\n' ' ' || true)
cat > "$WORK/esp/EFI/BOOT/grub.cfg" <<EOF
serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1
default=boot
timeout=3

menuentry 'CIDINT OS' --id boot {
    linux /bzImage root=PARTUUID=$UUID_A rootwait rootfstype=ext4 ro cidint.mode=installed $CONSOLES $KARGS
}
EOF
sync
umount "$WORK/esp"

say "verifying the written system image"
e2fsck -fn "${P}2" >/dev/null 2>&1 || fail "system partition failed its filesystem check"

sync
echo
say "installation finished. Remove the live medium and restart."
if [ "$ENCRYPT" -eq 1 ]; then
    say "the data volume is encrypted; its passphrase is asked for at every start."
else
    say "the data volume is NOT encrypted (--encrypt-data was not given)."
fi
[ -n "$ROOTPW" ] || say "WARNING: root has no password on the installed system."

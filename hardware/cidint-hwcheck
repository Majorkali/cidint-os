#!/bin/sh
# cidint-hwcheck - record how CIDINT OS runs on this computer.
#
#   cidint-hwcheck [--out DIR]
#
# Reads only (nothing is changed, nothing is sent anywhere) and writes a
# plain-text report: firmware and boot mode, processor, memory, every PCI
# and USB device with the driver the kernel bound to it (or none), network
# links, graphics outputs, disks, and the health of the system's services.
# Devices without a driver are what does not work on this computer yet.
#
# The report goes to /data/hwcheck/ (or DIR, e.g. a mounted USB stick)
# and is also printed. It contains serial-number-free hardware data, the
# host name and MAC addresses; look at it before sharing it.
#
# Exit codes: 0 report written, 1 failure, 2 usage.
set -u

OUT=/data/hwcheck
case "${1:-}" in
    --out) [ $# -eq 2 ] || { echo "Usage: cidint-hwcheck [--out DIR]" >&2; exit 2; }; OUT=$2 ;;
    "") ;;
    *) echo "Usage: cidint-hwcheck [--out DIR]" >&2; exit 2 ;;
esac

rd() { cat "$1" 2>/dev/null | tr -d '\n'; }
section() { printf '\n== %s ==\n' "$1"; }
cmdline_value() { tr ' ' '\n' < /proc/cmdline | sed -n "s/^$1=//p" | tail -n 1; }

report() {
    echo "CIDINT OS hardware report"
    echo "date            : $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
    echo "system          : $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}")"
    echo "kernel          : $(uname -r) $(uname -m)"
    echo "mode            : $(cmdline_value cidint.mode) $( [ -n "$(cmdline_value cidint.slot)" ] && echo "(slot $(cmdline_value cidint.slot))")"

    section "Firmware"
    if [ -d /sys/firmware/efi ]; then
        echo "boot mode       : UEFI ($(rd /sys/firmware/efi/fw_platform_size)-bit firmware)"
        sb=$(od -An -t u1 -j 4 -N 1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ')
        echo "secure boot     : $(case "$sb" in 1) echo on;; 0) echo off;; *) echo unknown;; esac)"
    else
        echo "boot mode       : legacy BIOS"
    fi
    echo "vendor          : $(rd /sys/class/dmi/id/sys_vendor)"
    echo "product         : $(rd /sys/class/dmi/id/product_name) $(rd /sys/class/dmi/id/product_version)"
    echo "board           : $(rd /sys/class/dmi/id/board_vendor) $(rd /sys/class/dmi/id/board_name)"
    echo "firmware        : $(rd /sys/class/dmi/id/bios_vendor) $(rd /sys/class/dmi/id/bios_version) $(rd /sys/class/dmi/id/bios_date)"

    section "Processor and memory"
    echo "processor       : $(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -n 1)"
    echo "logical CPUs    : $(grep -c '^processor' /proc/cpuinfo)"
    echo "virtualisation  : $(grep -qw -e vmx -e svm /proc/cpuinfo && echo 'supported (needed for security domains)' || echo 'not available')"
    echo "kvm device      : $([ -c /dev/kvm ] && echo present || echo absent)"
    echo "memory          : $(awk '/^MemTotal/ { printf "%.1f GiB", $2 / 1048576 }' /proc/meminfo)"

    section "PCI devices (vendor:device class driver)"
    nodrv=0
    for d in /sys/bus/pci/devices/*; do
        [ -e "$d" ] || continue
        drv=$(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)
        [ -n "$drv" ] || { drv="NO DRIVER"; nodrv=$((nodrv + 1)); }
        printf '%s  %s:%s  class %s  %s\n' "$(basename "$d")" "$(rd "$d/vendor" | sed 's/0x//')" \
            "$(rd "$d/device" | sed 's/0x//')" "$(rd "$d/class" | sed 's/0x//')" "$drv"
    done
    echo "PCI devices without a driver: $nodrv"

    section "USB devices (vendor:product name driver)"
    for d in /sys/bus/usb/devices/*; do
        [ -f "$d/idVendor" ] || continue
        drvs=""
        for i in "$d"/*:*; do
            [ -e "$i/driver" ] && drvs="$drvs $(basename "$(readlink "$i/driver")")"
        done
        printf '%s  %s:%s  %s %s  %s\n' "$(basename "$d")" "$(rd "$d/idVendor")" "$(rd "$d/idProduct")" \
            "$(rd "$d/manufacturer")" "$(rd "$d/product")" "${drvs:- (no interface driver)}"
    done

    section "Network"
    for n in /sys/class/net/*; do
        name=$(basename "$n")
        [ "$name" = lo ] && continue
        kind=virtual
        [ -e "$n/device" ] && kind="card ($(basename "$(readlink "$n/device/driver" 2>/dev/null)" 2>/dev/null || echo no driver))"
        [ -d "$n/wireless" ] && kind="wireless $kind"
        echo "$name  $kind  state $(rd "$n/operstate")  $(rd "$n/address")"
    done
    ip -o -4 addr show 2>/dev/null | awk '{ print "address         : " $2 " " $4 }'

    section "Graphics"
    for c in /sys/class/drm/card*; do
        [ -e "$c" ] || continue
        case "$(basename "$c")" in
            *-*) echo "output $(basename "$c")  $(rd "$c/status")  $(head -n 1 "$c/modes" 2>/dev/null)" ;;
            *) echo "card $(basename "$c")  driver $(basename "$(readlink "$c/device/driver" 2>/dev/null)" 2>/dev/null)" ;;
        esac
    done
    [ -e /sys/class/drm/card0 ] || echo "no graphics device with a kernel driver (the desktop cannot start)"

    section "Storage"
    for b in /sys/block/*; do
        n=$(basename "$b")
        case "$n" in loop*|ram*|zram*|dm-*) continue ;; esac
        echo "$n  $(( $(rd "$b/size") * 512 / 1048576 )) MiB  $(rd "$b/device/model")  removable=$(rd "$b/removable")  $( [ "$(rd "$b/queue/rotational")" = 0 ] && echo solid-state || echo rotating)"
    done
    grep -E ' (/|/boot|/data|/home) ' /proc/mounts | awk '{ print "mounted         : " $2 " <- " $1 " (" $3 ", " $4 ")" }'

    section "Sound and input"
    ls /proc/asound/card*/id >/dev/null 2>&1 && for c in /proc/asound/card*/id; do echo "sound card      : $(cat "$c")"; done || echo "sound card      : none detected"
    grep -h '^N: Name=' /proc/bus/input/devices 2>/dev/null | sed 's/^N: Name=/input device    : /'

    section "Bluetooth"
    found_bt=0
    for h in /sys/class/bluetooth/hci*; do
        [ -e "$h" ] || continue
        found_bt=1
        echo "$(basename "$h")  driver $(basename "$(readlink -f "$h/device/driver" 2>/dev/null)" 2>/dev/null)  $(rd "$h/address" 2>/dev/null)"
    done
    [ $found_bt -eq 1 ] || echo "no Bluetooth controller found"
    command -v rfkill >/dev/null 2>&1 && rfkill list 2>/dev/null | sed 's/^/  /'

    section "Secure Boot"
    if command -v cidint-secureboot >/dev/null 2>&1; then cidint-secureboot status; fi

    section "OpenGL (cidint-gpucheck)"
    if command -v cidint-gpucheck >/dev/null 2>&1; then
        cidint-gpucheck 2>&1
    else
        echo "not installed on this edition (Desktop Edition only)"
    fi

    section "Sound (cidint-soundcheck)"
    if command -v cidint-soundcheck >/dev/null 2>&1; then cidint-soundcheck 2>&1; else echo "not installed on this edition"; fi

    section "System health"
    echo "state           : $(systemctl is-system-running 2>/dev/null)"
    systemctl --failed --no-legend --plain 2>/dev/null | awk '{ print "failed unit     : " $1 }'
    echo "kernel errors   : $(dmesg --level=err,crit,alert,emerg 2>/dev/null | wc -l) line(s)"
    dmesg --level=err,crit,alert,emerg 2>/dev/null | tail -n 15 | sed 's/^/  /'
    echo "firmware files the kernel asked for and did not find:"
    dmesg 2>/dev/null | grep -i 'firmware.*\(failed\|not found\|-2\)' | tail -n 10 | sed 's/^/  /'
}

mkdir -p "$OUT" 2>/dev/null || { echo "cidint-hwcheck: cannot create $OUT" >&2; exit 1; }
FILE="$OUT/hwcheck-$(date -u +%Y%m%d-%H%M%S).txt"
report | tee "$FILE"
echo
echo "Report saved to $FILE"

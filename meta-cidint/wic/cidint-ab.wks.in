# CIDINT OS disk layout (GPT, UEFI).
#
#   1  esp          EFI system partition, boot loader and kernel
#   2  system-a     read-only system image (active)
#   3  system-b     reserved for A/B updates (empty until the update
#                   manager exists)
#   4  cidint-data  ALL persistent state: /data, with /home bound to
#                   /data/home. Never rewritten by a system update.
#
# The system slots have a fixed size so a later image always fits the
# other slot. The data partition is created once, at install time.
part /boot --source bootimg-efi --sourceparams="loader=${EFI_PROVIDER}" --label esp --active --align 1024 --use-uuid --fixed-size 128M
part / --source rootfs --fstype=ext4 --label system-a --align 1024 --use-uuid --fixed-size 1024M
part --fstype=ext4 --label system-b --align 1024 --fixed-size 1024M
part /data --fstype=ext4 --label cidint-data --align 1024 --use-uuid --size 1024M

bootloader --ptable gpt --timeout=3 --append=" rootfstype=ext4 ro cidint.mode=installed ${APPEND}"

# CIDINT OS Server Edition: SSH daemon configuration.
# Key-based logins only. The host key lives on the data volume so that it
# survives restarts and system updates (the system image is read-only).
HostKey /data/server/ssh/ssh_host_ed25519_key

PubkeyAuthentication yes
# Authorised keys are configuration and live on the data volume, one file
# per account, writable by root only. (root's own home directory is on
# the read-only system image.)
AuthorizedKeysFile /data/config/ssh/authorized_keys/%u
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin prohibit-password

X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
MaxAuthTries 3
LoginGraceTime 30

Subsystem sftp internal-sftp

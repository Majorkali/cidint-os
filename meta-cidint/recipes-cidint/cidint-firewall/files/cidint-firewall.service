[Unit]
Description=CIDINT firewall (default-deny inbound)
Documentation=file:///etc/cidint/firewall.nft
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
After=systemd-sysctl.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/cidint/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/cidint/firewall.nft

[Install]
WantedBy=sysinit.target
